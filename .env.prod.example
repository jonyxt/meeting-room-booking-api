# Production Docker image (fixed digest)
APP_IMAGE=ghcr.io/jonyxt/shift_test_task@sha256:268b38000dcb57b82fe3e41317ac7ae7180f66d09bfc6a0a2b12560359634dc1

APP_ENV=prod
APP_BIND_PORT=8001

# PostgreSQL
POSTGRES_USER=booking_app
POSTGRES_PASSWORD=replace_with_strong_random_password
POSTGRES_DB=booking_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# JWT
JWT_SECRET=replace_with_random_secret_of_at_least_32_bytes
JWT_ALGORITHM=HS256
JWT_EXP_DELTA_SECONDS=3600
