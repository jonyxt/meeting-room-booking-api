# Docker image published by GitHub Actions
APP_IMAGE=ghcr.io/jonyxt/meeting-room-booking-api:main

APP_ENV=prod
APP_BIND_PORT=8001

# PostgreSQL
POSTGRES_USER=booking_app
POSTGRES_PASSWORD=replace_with_strong_random_password
POSTGRES_DB=booking_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# JWT
JWT_SECRET=replace_with_random_secret_of_at_least_32_bytes
JWT_ALGORITHM=HS256
JWT_EXP_DELTA_SECONDS=3600
